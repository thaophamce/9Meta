{
  "name": "9meta",
  "version": "2.5.53",
  "description": "Nhà Yến Zalo - Quản lý nhiều tài khoản, người dùng và nhóm Zalo trên Desktop.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:electron-unfriend": "electron test/electron-unfriend-detached-smoke.js",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.nhayen.zalo",
    "productName": "Nhà Yến Zalo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "update-notice.html",
      "custom_style.css",
      "modules/**/*.js",
      "icon.ico",
      "icon.png",
      "brand-logo.png",
      "assets/fonts/Quicksand-VariableFont_wght.ttf",
      "assets/default-quick-replies/**/*",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business"
    },
    "dmg": {
      "artifactName": "Nha-Yen-Zalo-Setup-${version}-${arch}.${ext}",
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Nhà Yến Zalo",
      "artifactName": "Nha-Yen-Zalo-Setup-${version}.${ext}",
      "include": "build/installer-access-code.nsh"
    },
    "releaseInfo": {
      "releaseNotes": "2.5.53:\n- Sửa lỗi Tạo đơn báo \"Chưa có thông tin kho hàng\": tách rõ nguyên nhân lỗi tải danh sách kho, hiển thị lý do chi tiết và hướng dẫn mở tab Pancake để tải lại.\n- Đơn thiết kế: thêm 3 thuộc tính GẤP / Có phí thiết kế (100.000đ) / Outsource, đồng bộ 2 chiều với Nhà Yến POS, chỉ lưu khi bấm Tạo/Cập nhật.\n- Đơn thiết kế: thêm khối Lịch sử hoạt động (tạo đơn, đổi trạng thái/Designer/deadline/số mẫu/ghi chú, bật/tắt GẤP/Có phí/Outsource) dùng lịch sử chung của POS.\n- Pancake: cho phép Tạo đơn nhanh không cần sản phẩm (items: []), đơn 0đ, không tự gắn \"Tiền đặt cọc\"/sản phẩm giả, có nút Hủy đơn thử.\n- Ổn định phiên Zalo và các sửa nhỏ khác từ nhánh 2.5.42-ctotest."
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thaophamce",
        "repo": "nhayen-zalo-updates"
      }
    ],
    "extraResources": [
      {
        "from": "assets/default-videos",
        "to": "default-videos",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "author": "Tiodev71",
  "license": "MIT",
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "electron-updater": "^6.8.3",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "allowScripts": {
    "electron@29.4.6": true
  }
}
